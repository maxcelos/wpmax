services:
  wordpress:
    image: wordpress:latest
    container_name: {{.Name}}-wordpress
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: {{.DBUser}}
      WORDPRESS_DB_PASSWORD: {{.DBPassword}}
      WORDPRESS_DB_NAME: wordpress
      WORDPRESS_CONFIG_EXTRA: |
        define('COOKIE_DOMAIN', '{{.Name}}.wpmax.localhost');
    volumes:
      - wp_data:/var/www/html
      - ./wp-content:/var/www/html/wp-content
{{- if .PluginsMount}}
      - {{.PluginsMount}}:/mnt/plugins:ro
{{- end}}
{{- if .ThemesMount}}
      - {{.ThemesMount}}:/mnt/themes:ro
{{- end}}
    healthcheck:
      test: ["CMD", "php", "-r", "exit(file_exists('/var/www/html/wp-includes/version.php') ? 0 : 1);"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 10s
    networks:
      - default
      - wpmax

  db:
    image: mariadb:11
    container_name: {{.Name}}-db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: {{.DBPassword}}
      MYSQL_DATABASE: wordpress
      MYSQL_USER: {{.DBUser}}
      MYSQL_PASSWORD: {{.DBPassword}}
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 10s

  cli:
    image: wordpress:cli
    container_name: {{.Name}}-cli
    profiles:
      - cli
    depends_on:
      wordpress:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: {{.DBUser}}
      WORDPRESS_DB_PASSWORD: {{.DBPassword}}
      WORDPRESS_DB_NAME: wordpress
    volumes:
      - wp_data:/var/www/html
      - ./wp-content:/var/www/html/wp-content
{{- if .PluginsMount}}
      - {{.PluginsMount}}:/mnt/plugins:ro
{{- end}}
{{- if .ThemesMount}}
      - {{.ThemesMount}}:/mnt/themes:ro
{{- end}}
    user: "33:33"

volumes:
  wp_data:
  db_data:

networks:
  default:
  wpmax:
    external: true